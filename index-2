<!DOCTYPE html>
<html lang="tr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="manifest" href="manifest.json"><meta name="theme-color" content="#0f766e"><link rel="icon" href="icon-192.png">
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<title>Mola Takip</title>
<style>
:root{--bg:#f6f5f1;--card:#fff;--tx:#1d1d1b;--mut:#6b6a64;--ac:#0f766e;--bad:#b91c1c;--ok:#15803d;--bd:#e3e1d9;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141413;--card:#1f1f1d;--tx:#f1efe8;--mut:#a3a199;--ac:#2dd4bf;--bad:#f87171;--ok:#4ade80;--bd:#33332f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#141413;--card:#1f1f1d;--tx:#f1efe8;--mut:#a3a199;--ac:#2dd4bf;--bad:#f87171;--ok:#4ade80;--bd:#33332f;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.4 system-ui,sans-serif}
#app{max-width:480px;margin:0 auto;padding:16px}
header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:14px;margin:10px 0}
.row{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--bd)}
.row:last-child{border:0}
.mut{color:var(--mut);font-size:14px}
.big{font-size:44px;font-weight:700;text-align:center;margin:8px 0;font-variant-numeric:tabular-nums}
.over{color:var(--bad)}
button,select,input{font:inherit;border-radius:10px;border:1px solid var(--bd);padding:12px;background:var(--card);color:var(--tx);width:100%;box-sizing:border-box;margin:4px 0}
button{background:var(--ac);color:#fff;border:0;font-weight:600;cursor:pointer}
button.g{background:transparent;color:var(--mut);border:1px solid var(--bd);width:auto;padding:6px 12px}
button.t{background:var(--card);color:var(--tx);border:1px solid var(--bd);text-align:left;display:flex;justify-content:space-between}
button:disabled{opacity:.45}
.tabs{display:flex;gap:6px}.tabs button{background:var(--card);color:var(--tx);border:1px solid var(--bd)}.tabs button.on{background:var(--ac);color:#fff}
.err{color:var(--bad);font-size:14px}
</style></head><body><div id="app"></div>
<script>
const TYPES=[["sabah","Sabah kahvaltısı",15],["cay1","Çay molası 1",20],["yemek","Öğle yemeği",30],["cay2","Çay molası 2",20],["aksam","Akşam kahvaltısı",15]];
const ADMIN_PIN="1234"; // yönetici şifresi: değiştirin
let S={staff:{},active:{},logs:{}},me=null,db=null,mode="in",msg="";
try{me=JSON.parse(localStorage.getItem("mt_me"))}catch(e){}
const today=()=>new Date().toLocaleDateString("sv");
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const hm=t=>new Date(t).toLocaleTimeString("tr",{hour:"2-digit",minute:"2-digit"});
const fmt=ms=>{const s=Math.abs(Math.round(ms/1000));return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0")};
const $=id=>document.getElementById(id);
const saveLocal=()=>{try{localStorage.setItem("mt_data",JSON.stringify(S))}catch(e){}};
async function put(c,id,d){try{if(db)await db.doc(c+"/"+id).set(d);else{S[c][id]=d;saveLocal()}}catch(e){msg="Kaydedilemedi, yetkiniz olmayabilir."}render()}
async function del(c,id){try{if(db)await db.doc(c+"/"+id).delete();else{delete S[c][id];saveLocal()}}catch(e){msg="Silinemedi."}render()}
function setMe(v){me=v;try{v?localStorage.setItem("mt_me",JSON.stringify(v)):localStorage.removeItem("mt_me")}catch(e){}msg="";render()}
const logout=()=>setMe(null);
function login(){
  const pin=$("pin").value.trim();
  if(mode==="adm"){return pin===ADMIN_PIN?setMe({role:"admin"}):(msg="Şifre yanlış",render())}
  if(!/^\d{4}$/.test(pin)){msg="4 haneli PIN girin";return render()}
  if(mode==="reg"){const name=$("name").value.trim();if(!name){msg="Ad soyad girin";return render()}
    const id="s"+Date.now().toString(36);put("staff",id,{name,pin}).then(()=>setMe({role:"staff",id}));return}
  const id=$("who").value,s=S.staff[id];
  s&&s.pin===pin?setMe({role:"staff",id}):(msg="PIN yanlış",render())
}
function startBreak(k){const s=S.staff[me.id],t=TYPES.find(x=>x[0]===k);
  put("active",me.id,{type:k,name:s.name,start:Date.now(),dur:t[2]})}
async function endBreak(){const a=S.active[me.id];if(!a)return;const end=Date.now(),d=today();
  await put("logs",me.id+"_"+a.type+"_"+d,{staffId:me.id,name:a.name,type:a.type,start:a.start,end,dur:a.dur,date:d});
  await del("active",me.id)}
function loginHTML(){
  const ids=Object.keys(S.staff);
  return `<h2>Mola Takip</h2><div class="tabs">${[["in","Giriş"],["reg","Kayıt ol"],["adm","Yönetici"]].map(([m,l])=>`<button class="${mode===m?"on":""}" onclick="mode='${m}';msg='';render()">${l}</button>`).join("")}</div>
  <div class="card">${mode==="reg"?`<input id="name" placeholder="Ad soyad">`:""}
  ${mode==="in"?(ids.length?`<select id="who">${ids.map(i=>`<option value="${i}">${esc(S.staff[i].name)}</option>`).join("")}</select>`:`<div class="mut">Henüz kayıtlı personel yok. "Kayıt ol" sekmesini kullanın.</div>`):""}
  <input id="pin" type="password" inputmode="numeric" maxlength="${mode==="adm"?8:4}" placeholder="${mode==="adm"?"Yönetici şifresi":"4 haneli PIN"}">
  <div class="err">${esc(msg)}</div><button onclick="login()">${mode==="reg"?"Kaydol":"Giriş yap"}</button></div>
  ${db?"":`<div class="mut">Deneme modu: veriler yalnızca bu cihazda saklanır.</div>`}`}
function staffHTML(){
  const s=S.staff[me.id];if(!s)return logout(),"";
  const act=S.active[me.id],d=today();
  let h=`<header><b>${esc(s.name)}</b><button class="g" onclick="logout()">Çıkış</button></header><div class="err">${esc(msg)}</div>`;
  if(act){const t=TYPES.find(x=>x[0]===act.type);
    h+=`<div class="card"><div class="mut">${t[1]} · ${t[2]} dk</div><div class="big" data-end="${act.start+act.dur*60000}">--:--</div><button onclick="endBreak()">Molayı bitir</button></div>`}
  h+=`<h3>Bugünkü molalar</h3>`+TYPES.map(([k,l,m])=>{const u=S.logs[me.id+"_"+k+"_"+d];
    return `<button class="t" ${u||act?"disabled":""} onclick="startBreak('${k}')"><span>${l}</span><span>${u?"✓ "+hm(u.start):m+" dk"}</span></button>`}).join("");
  return h}
function adminHTML(){
  const d=today(),act=Object.entries(S.active),logs=Object.values(S.logs).filter(l=>l.date===d).sort((a,b)=>a.start-b.start);
  let h=`<header><b>Yönetici paneli</b><button class="g" onclick="logout()">Çıkış</button></header><div class="err">${esc(msg)}</div>
  <h3>Şu an molada (${act.length})</h3><div class="card">${act.length?act.map(([i,a])=>`<div class="row"><div>${esc(a.name)}<div class="mut">${TYPES.find(x=>x[0]===a.type)[1]}</div></div><b data-end="${a.start+a.dur*60000}">--:--</b></div>`).join(""):`<div class="mut">Kimse molada değil.</div>`}</div>
  <h3>Bugünkü rapor</h3><div class="card">${logs.length?logs.map(l=>{const used=Math.round((l.end-l.start)/60000),over=used-l.dur;
    return `<div class="row"><div>${esc(l.name)}<div class="mut">${TYPES.find(x=>x[0]===l.type)[1]} · ${hm(l.start)}-${hm(l.end)}</div></div><span class="${over>0?"over":""}">${used} dk${over>0?" (+"+over+")":""}</span></div>`}).join(""):`<div class="mut">Bugün tamamlanan mola yok.</div>`}</div>
  <h3>Personel (${Object.keys(S.staff).length})</h3><div class="card">${Object.entries(S.staff).map(([i,s])=>{const n=TYPES.filter(t=>S.logs[i+"_"+t[0]+"_"+d]).length;
    return `<div class="row"><div>${esc(s.name)}<div class="mut">Bugün ${n}/${TYPES.length} mola</div></div><button class="g" onclick="del('staff','${i}')">Sil</button></div>`}).join("")||`<div class="mut">Kayıtlı personel yok.</div>`}</div>`;
  return h}
function render(){
  if(!me&&document.activeElement&&document.activeElement.tagName==="INPUT")return;
  $("app").innerHTML=!me?loginHTML():me.role==="admin"?adminHTML():staffHTML();tick()}
let buzzed={};
function tick(){document.querySelectorAll("[data-end]").forEach(el=>{const e=+el.dataset.end,r=e-Date.now();
  el.textContent=(r<0?"+":"")+fmt(r);el.classList.toggle("over",r<0);
  if(r<0&&me&&me.role==="staff"&&!buzzed[e]){buzzed[e]=1;try{navigator.vibrate&&navigator.vibrate([300,150,300])}catch(x){}}})}
setInterval(tick,1000);
(async()=>{
  try{
    firebase.initializeApp({apiKey:"AIzaSyD_Bl_RC8xzscXA3-GP8X2tdBi6tFhCs8E",authDomain:"mola-takip-7fc53.firebaseapp.com",projectId:"mola-takip-7fc53",storageBucket:"mola-takip-7fc53.firebasestorage.app",messagingSenderId:"130287831940",appId:"1:130287831940:web:c3a804d90a0225231b2bd1"});
    await firebase.auth().signInAnonymously();
    db=firebase.firestore();
    ["staff","active","logs"].forEach(c=>db.collection(c).onSnapshot(sn=>{S[c]={};sn.docs.forEach(x=>S[c][x.id]=x.data());render()},e=>{msg="Bağlantı hatası: "+e.code;render()}));
  }catch(e){db=null;msg="Sunucuya bağlanılamadı";try{S=Object.assign(S,JSON.parse(localStorage.getItem("mt_data")))}catch(x){}render()}
})();
try{navigator.serviceWorker&&navigator.serviceWorker.register("sw.js")}catch(e){}
render();
</script></body></html>
